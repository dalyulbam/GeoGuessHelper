# ── GeoGuessHelper 시크릿 ─────────────────────────────────────────────
# 이 파일을 `.env` 로 복사하고 값을 채우세요.  (다운로드/추출만 쓸 거면 키 없이도 서버는 뜹니다)

# Maps JavaScript API 키 — 브라우저의 2분할 로드뷰/지도 렌더에 사용.
#  · Google Cloud Console 에서 "Maps JavaScript API" 활성화
#  · 애플리케이션 제한: "HTTP 리퍼러" → http://localhost:8799/*, http://127.0.0.1:8799/*
#    (서버가 실제로 쓰는 포트는 시작 시 배너에 표시됨 — 그 포트를 등록하세요)
#    (헤드리스 캡처까지 쓰면 http://localhost:8080/*, http://localhost:8000/* 도 추가)
GOOGLE_MAPS_JS_API_KEY=

# Street View Static + Static Maps API 키 — 서버측 캡처(정적 이미지 합성)에 사용.
#  · "Street View Static API" 와 "Maps Static API" 활성화
#  · 애플리케이션 제한: "IP 주소"(또는 개발 중엔 제한 없음)
#  · 비워두면 위 JS 키를 대신 씁니다(개발 편의; 실제로는 별도 키 권장).
GOOGLE_MAPS_STATIC_KEY=

# Claude 비전 분석용
ANTHROPIC_API_KEY=

# ── 선택 튜닝 변수 (전부 생략 가능 — 코드 기본값으로 동작) ──────────────

# 서버 포트 — 기본 8799 (YCollector 8765 와 충돌 회피, 쓰는 중이면 다음 빈 포트로 자동 이동)
# GEOHELPER_PORT=8799

# 분석/보고서 기본 출력 언어 — 기본 ko
# GEOHELPER_REPORT_LANG=ko

# 캡처 저장 경로 — 기본 <프로젝트 루트>/captures
# GEOHELPER_CAPTURES=

# 지식 저장소 경로 — 기본 <프로젝트 루트>/docs/knowledge
# GEOHELPER_KNOWLEDGE=

# 잡 큐 동시 실행 수(1~8) — 기본 1(완전 순차)
# GEOHELPER_JOB_CONCURRENCY=1

# 헤드리스 Chromium 동시 실행 상한(1~4) — 기본 1
# GEOHELPER_CAPTURE_CONCURRENCY=1

# 리서치 단계 웹 검색 최대 횟수(0~10) — 기본 3
# GEOHELPER_WEB_SEARCH_MAX=3

# 캡처 이미지 품질(40~100, JPEG 기준) — 기본 85
# GEOHELPER_CAPTURE_QUALITY=85

# 캡처 저장 형식 png|jpeg — 기본 jpeg
# GEOHELPER_CAPTURE_FORMAT=jpeg

# ── 브라우저 렌더 타이밍 ──────────────────────────────────────────────────────
# 헤드리스 Chromium 을 프로세스 수명 동안 재사용한다 — 기본 켜짐. 0/false/no/off 로 끄면
# 예전처럼 캡처마다 띄우고 닫는다(실시간 백신 환경에서 close 하나가 16~66초 걸린 실측 있음).
# GEOHELPER_RENDER_REUSE_BROWSER=1

# 파노 setPano 직후 브라우저 안에서의 최소 대기 ms(0~10000) — 기본 250
# GEOHELPER_RENDER_SETTLE_MS=250

# 타일 응답이 이만큼 조용하면 정착으로 본다 ms(50~5000) — 기본 350
# GEOHELPER_RENDER_QUIET_MS=350

# 타일이 계속 흘러도 여기서 끊는다 ms(200~20000) — 기본 3000
# GEOHELPER_RENDER_SETTLE_MAX_MS=3000

# 하단 지도 타일 대기 상한 ms(0~20000) — 기본 2500.
# 지도는 파노 조회와 **동시에** 띄우므로 이 값은 그 병렬 경로의 상한일 뿐이다.
# GEOHELPER_RENDER_MAP_WAIT_MS=2500

# 캡처 한 건의 벽시계 상한 초(10~600) — 기본 75. 넘으면 CAPTURE_TIMEOUT 을 돌려준다.
# GEOHELPER_CAPTURE_TIMEOUT_S=75

# 렌더 워커 상한 초(10~600) — 기본 60. 위 값보다 짧아야 워커가 먼저 풀린다.
# 넘으면 그 브라우저를 버리고 새 워커로 갈아 끼운다(막힌 렌더가 뒤를 막지 않게).
# GEOHELPER_RENDER_WORKER_TIMEOUT_S=60

# ── TLS ───────────────────────────────────────────────────────────────────────
# 백신·사내 프록시가 TLS 를 가로채는 환경에서도 **검증을 끄지 않는다**.
# 시작 시 strict → 규격 완화(VERIFY_X509_STRICT 해제) → 포기 순으로 한 칸씩만 내려간다.
# 이 PC 는 relaxed 에서 통과한다(가로채기 CA 의 Basic Constraints 가 non-critical).
#   1/true  = 항상 verify=False (권장하지 않음)
#   0/false = 항상 엄격 검증 (완화조차 안 함 — 가로채기 환경에서는 요청이 실패한다)
# GEOHELPER_INSECURE_TLS=

# 지식 적재를 완전히 끈다(1/true/yes/on) — 기본 꺼짐(적재 켜짐)
# GEOHELPER_KNOWLEDGE_OFF=

# ── 다중 사용자 서버 (전부 비우면 지금까지처럼 단독 소유자 모드) ────────────────
# DATABASE_URL 이 있을 때만 회원가입·인증·개별 지식 저장소가 켜진다.
# 로컬 시험: sqlite:///D:/26y/GeoGuessHelper/data/app.db
# Railway 는 Postgres 를 붙이면 DATABASE_URL 을 자동 주입한다(postgres:// 스킴은 알아서 보정).
# DATABASE_URL=

# 회원 API 키 암호화 비밀(16자 이상). **없으면 키를 아예 보관하지 않는다** —
# "일단 평문으로" 를 코드가 막는다. 바꾸면 기존에 저장된 키를 못 읽으니 재입력이 필요하다.
# GEOHELPER_KEY_SECRET=

# 구글 로그인 — 없으면 이메일 가입만 열린다.
# 승인된 리디렉션 URI: <공개주소>/api/auth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# 외부에서 보이는 주소 — **선택**. 비우면 요청에서 알아낸다.
# 리버스 프록시 뒤에서 주소가 여러 개거나 OAuth 리디렉션을 한 곳으로 고정하고 싶을 때만 넣는다.
# GEOHELPER_PUBLIC_URL=https://example.up.railway.app

# 관리자 이메일(쉼표 구분) — 처음부터 pro 이고 /api/admin/* 을 쓸 수 있다.
# GEOHELPER_ADMIN_EMAILS=you@example.com

# 무료 회원이 DB 에 쌓을 수 있는 원자 수 — 기본 200. 넘으면 저장을 멈추고 화면이 알린다.
# GEOHELPER_FREE_ATOM_LIMIT=200

# 회원별 데이터(지식 저장소·캡처)가 쌓이는 뿌리. 배포에서는 볼륨을 여기에 붙인다.
# GEOHELPER_DATA_DIR=/data

# 서버가 바인드할 호스트. $PORT 가 있으면 자동으로 0.0.0.0 이 되므로 보통 건드릴 필요 없다.
# GEOHELPER_HOST=
