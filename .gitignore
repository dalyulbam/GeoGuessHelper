# Python / uv
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# secrets
.env

# runtime artifacts
captures/
# 보고서는 전부 로컬 전용 — 하위 폴더(크로아시아/, atlas/ …)와 zip 까지 통째로 막아
# 용량 과다(실측 328MB)를 방지한다. 이전의 docs/report/*.html 은 * 가 / 를 넘지
# 못해 하위 폴더가 새고 있었다.
docs/report/*
!docs/report/.gitkeep
# 작업 큐 실행 로그 — 실행할 때마다 바뀌는 상태 (gitignore 는 인라인 주석을 지원하지 않는다)
docs/jobs/

# docs/knowledge/ 는 **의도적으로 커밋한다** — 보고서를 만들수록 쌓이는 지식 저장소이고,
# 다음 조사에서 재검색을 건너뛰는 근거가 된다(원자 .md + 장소/엔티티 백링크).

# Playwright 실증 산출물(스크린샷) — 로컬 전용
.testout/

# 참고용 스크린샷 모음 — 로컬 전용. 폴더째 막아 하위(legacy/ …)까지 포함한다.
reference/

# Windows 탐색기가 폴더마다 남기는 아이콘 설정 파일
desktop.ini
altaiya_local_backup/
