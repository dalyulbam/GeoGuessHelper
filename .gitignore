# Python / uv
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
dist/

# secrets
.env

# runtime artifacts
captures/
docs/report/*.html
docs/report/*.script.json
# retranslate 가 남기는 원본 백업 — 로컬 안전장치일 뿐 저장소에 넣지 않는다
docs/report/*.bak
!docs/report/.gitkeep
# 작업 큐 실행 로그 — 실행할 때마다 바뀌는 상태 (gitignore 는 인라인 주석을 지원하지 않는다)
docs/jobs/

# docs/knowledge/ 는 **의도적으로 커밋한다** — 보고서를 만들수록 쌓이는 지식 저장소이고,
# 다음 조사에서 재검색을 건너뛰는 근거가 된다(원자 .md + 장소/엔티티 백링크).

# Playwright 실증 산출물(스크린샷) — 로컬 전용
.testout/
